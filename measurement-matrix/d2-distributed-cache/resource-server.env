# Shared by all three replicas. NODE_ID and DPOP_JTI_CACHE are set per service in
# docker-compose.yml. Values here are literal: Compose does not interpolate env_file.

# Issuer is validated as localhost:8180, which is what Keycloak mints. Keys are fetched
# over the compose network, where that host name does not resolve.
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=http://localhost:8180/realms/dpop-demo
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWK_SET_URI=http://keycloak:8080/realms/dpop-demo/protocol/openid-connect/certs

SERVER_PORT=8081
REDIS_HOST=redis
REDIS_PORT=6379
